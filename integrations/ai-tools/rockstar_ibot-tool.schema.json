{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/k999ln/Mr./main/integrations/ai-tools/rockstar_ibot-tool.schema.json",
  "title": "Rockstar_ibot AI tool policy overlay",
  "description": "Fail-closed permissions, execution, billing, and receipt contract layered on an MCP Registry server.json manifest.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "$schema",
    "schemaVersion",
    "serverName",
    "kind",
    "compatibility",
    "capabilities",
    "requestedPermissions",
    "runtime",
    "commercial",
    "receipts"
  ],
  "properties": {
    "$schema": {
      "type": "string",
      "const": "https://raw.githubusercontent.com/k999ln/Mr./main/integrations/ai-tools/rockstar_ibot-tool.schema.json"
    },
    "schemaVersion": {
      "type": "integer",
      "const": 1
    },
    "serverName": {
      "type": "string",
      "pattern": "^[A-Za-z0-9.-]+/[A-Za-z0-9._-]+$",
      "maxLength": 200
    },
    "kind": {
      "type": "string",
      "enum": ["model_provider", "remote_tool", "service_cell"]
    },
    "compatibility": {
      "type": "object",
      "additionalProperties": false,
      "required": ["minimumCoreVersion", "surfaces"],
      "properties": {
        "minimumCoreVersion": {
          "type": "string",
          "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)(?:-[0-9A-Za-z.-]+)?$"
        },
        "surfaces": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "enum": ["web", "ios", "core", "local_bridge"]
          }
        }
      }
    },
    "capabilities": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "title",
          "description",
          "inputDataClasses",
          "outputDataClasses",
          "effect",
          "ownerApproval",
          "idempotencyRequired",
          "receiptRequired"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z0-9]+(?:[._-][a-z0-9]+)*$",
            "maxLength": 100
          },
          "title": { "type": "string", "minLength": 1, "maxLength": 100 },
          "description": { "type": "string", "minLength": 1, "maxLength": 240 },
          "inputDataClasses": {
            "$ref": "#/$defs/dataClasses"
          },
          "outputDataClasses": {
            "$ref": "#/$defs/dataClasses"
          },
          "effect": {
            "type": "string",
            "enum": ["read", "external_write", "message", "publish", "money"]
          },
          "ownerApproval": {
            "type": "string",
            "enum": ["install", "per_invocation"]
          },
          "idempotencyRequired": { "type": "boolean", "const": true },
          "receiptRequired": { "type": "boolean", "const": true }
        }
      }
    },
    "requestedPermissions": {
      "type": "object",
      "additionalProperties": false,
      "required": ["dataRead", "dataWrite", "credentialSlots", "network", "storage"],
      "properties": {
        "dataRead": { "$ref": "#/$defs/dataClasses" },
        "dataWrite": { "$ref": "#/$defs/dataClasses" },
        "credentialSlots": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["id", "purpose", "required"],
            "properties": {
              "id": {
                "type": "string",
                "pattern": "^[a-z0-9]+(?:[._-][a-z0-9]+)*$",
                "maxLength": 80
              },
              "purpose": { "type": "string", "minLength": 1, "maxLength": 200 },
              "required": { "type": "boolean" }
            }
          }
        },
        "network": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["scheme", "host", "port", "methods"],
            "properties": {
              "scheme": { "type": "string", "const": "https" },
              "host": {
                "type": "string",
                "pattern": "^(?=.{1,253}$)(?!.*\\*)(?:[A-Za-z0-9](?:[A-Za-z0-9-]{0,61}[A-Za-z0-9])?\\.)+[A-Za-z]{2,63}$"
              },
              "port": { "type": "integer", "const": 443 },
              "methods": {
                "type": "array",
                "minItems": 1,
                "uniqueItems": true,
                "items": {
                  "type": "string",
                  "enum": ["GET", "POST", "PUT", "PATCH", "DELETE"]
                }
              }
            }
          }
        },
        "storage": {
          "type": "object",
          "additionalProperties": false,
          "required": ["retentionDays", "containsPersonalData"],
          "properties": {
            "retentionDays": { "type": "integer", "minimum": 0, "maximum": 365 },
            "containsPersonalData": { "type": "boolean" }
          }
        }
      }
    },
    "runtime": {
      "type": "object",
      "additionalProperties": false,
      "required": ["mode", "timeoutMs", "maxOutputBytes", "maxConcurrency"],
      "properties": {
        "mode": {
          "type": "string",
          "enum": ["isolated_remote", "sandboxed_package"]
        },
        "timeoutMs": { "type": "integer", "minimum": 1000, "maximum": 300000 },
        "maxOutputBytes": { "type": "integer", "minimum": 1024, "maximum": 10485760 },
        "maxConcurrency": { "type": "integer", "minimum": 1, "maximum": 32 }
      }
    },
    "commercial": {
      "type": "object",
      "additionalProperties": false,
      "required": ["mode", "requiresQuote"],
      "properties": {
        "mode": {
          "type": "string",
          "enum": ["free", "fixed", "metered", "subscription", "quote"]
        },
        "requiresQuote": { "type": "boolean" },
        "currency": {
          "type": "string",
          "pattern": "^[A-Z]{3}$"
        }
      }
    },
    "receipts": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schemaVersion", "readback", "requiredFields"],
      "properties": {
        "schemaVersion": { "type": "integer", "const": 1 },
        "readback": {
          "type": "string",
          "enum": ["none", "provider_required"]
        },
        "requiredFields": {
          "type": "array",
          "minItems": 12,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9_]*$"
          }
        }
      }
    }
  },
  "$defs": {
    "dataClasses": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string",
        "enum": [
          "public_text",
          "generated_content",
          "owner_profile",
          "customer_content",
          "attachments",
          "calendar",
          "email",
          "finance",
          "location",
          "wellbeing"
        ]
      }
    }
  }
}
