{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/k999ln/Mr./main/integrations/ai-tools/discovery/producthunt-source.schema.json",
  "title": "Rockstar_ibot Product Hunt discovery source",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "$schema",
    "schemaVersion",
    "id",
    "displayName",
    "access",
    "commercialUse",
    "policy",
    "search"
  ],
  "properties": {
    "$schema": {
      "const": "./producthunt-source.schema.json"
    },
    "schemaVersion": {
      "const": 1
    },
    "id": {
      "const": "producthunt"
    },
    "displayName": {
      "const": "Product Hunt"
    },
    "access": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "mode",
        "endpoint",
        "scope",
        "productionCredentialMode",
        "credentialEnv",
        "commercialApprovalEnv"
      ],
      "properties": {
        "mode": {
          "const": "official_graphql_api"
        },
        "endpoint": {
          "const": "https://api.producthunt.com/v2/api/graphql"
        },
        "scope": {
          "const": "public"
        },
        "productionCredentialMode": {
          "const": "client_credentials_via_server_secret_broker"
        },
        "credentialEnv": {
          "const": "PRODUCT_HUNT_ACCESS_TOKEN"
        },
        "commercialApprovalEnv": {
          "const": "PRODUCT_HUNT_COMMERCIAL_API_APPROVED"
        }
      }
    },
    "commercialUse": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "state",
        "approvalReference",
        "contact",
        "apiPolicyUrl",
        "legalTermsUrl"
      ],
      "properties": {
        "state": {
          "enum": [
            "permission_required",
            "approved"
          ]
        },
          "approvalReference": {
            "type": [
              "string",
              "null"
            ],
            "minLength": 1,
            "maxLength": 200
        },
        "contact": {
          "const": "hello@producthunt.com"
        },
        "apiPolicyUrl": {
          "const": "https://api.producthunt.com/v2/docs"
        },
        "legalTermsUrl": {
          "const": "https://www.producthunt.com/legal"
        }
      }
    },
    "policy": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "scrapingAllowed",
        "autoApprovePackages",
        "candidateState",
        "candidateRetentionDays",
        "attributionLabel",
        "attributionUrl"
      ],
      "properties": {
        "scrapingAllowed": {
          "const": false
        },
        "autoApprovePackages": {
          "const": false
        },
        "candidateState": {
          "const": "candidate_only"
        },
        "candidateRetentionDays": {
          "type": "integer",
          "minimum": 1,
          "maximum": 30
        },
        "attributionLabel": {
          "const": "Source: Product Hunt"
        },
        "attributionUrl": {
          "const": "https://www.producthunt.com"
        }
      }
    },
    "search": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "strategy",
        "defaultQueries",
        "topicLimit",
        "postsPerTopic",
        "lookbackDays",
        "maxCandidates",
        "minimumRemainingBudget"
      ],
      "properties": {
        "strategy": {
          "const": "topics_then_posts"
        },
        "defaultQueries": {
          "type": "array",
          "minItems": 1,
          "maxItems": 8,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 2,
            "maxLength": 80,
            "pattern": "^(?!\\s)(?!.*\\s$)[^\\u0000-\\u001F\\u007F]+$"
          }
        },
        "topicLimit": {
          "type": "integer",
          "minimum": 1,
          "maximum": 5
        },
        "postsPerTopic": {
          "type": "integer",
          "minimum": 1,
          "maximum": 20
        },
        "lookbackDays": {
          "type": "integer",
          "minimum": 1,
          "maximum": 365
        },
        "maxCandidates": {
          "type": "integer",
          "minimum": 1,
          "maximum": 100
        },
        "minimumRemainingBudget": {
          "type": "integer",
          "minimum": 1,
          "maximum": 6250
        }
      }
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "commercialUse": {
            "type": "object",
            "properties": {
              "state": {
                "const": "approved"
              }
            }
          }
        }
      },
      "then": {
        "properties": {
          "commercialUse": {
            "type": "object",
            "properties": {
              "approvalReference": {
                "type": "string",
                "minLength": 1,
                "maxLength": 200,
                "pattern": "^[A-Za-z0-9][A-Za-z0-9:./_-]{0,199}$"
              }
            }
          }
        }
      },
      "else": {
        "properties": {
          "commercialUse": {
            "type": "object",
            "properties": {
              "approvalReference": {
                "const": null
              }
            }
          }
        }
      }
    }
  ]
}
