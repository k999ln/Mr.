LM_LOCAL_API_PORT=18788
LM_LOCAL_MINIO_PORT=19000
LM_LOCAL_MINIO_CONSOLE_PORT=19001
MINIO_ROOT_USER=life_manager_local
MINIO_ROOT_PASSWORD=replace-with-a-local-only-password

# Copy this file to deploy/local/.env and keep it chmod 600. Empty values disable the corresponding
# connector. `npm run owner:check -- --profile all` reports names only and never prints secrets.

# Installation-owned GitHub repository. Leave empty until the target exists and write access has
# been verified. GitHub issue/PR self-heal lanes remain disabled while this is empty.
LM_GITHUB_REPOSITORY=
# Optional live GitHub skills. Keep empty until gh readback confirms this installation has write access.
ANICCA_FORUM_REPO=
GITHUB_IDENTITY=
LM_SOURCE_REPOSITORY_URL=
LM_X402_DISCOVERY_HEALTH_URL=
JOB_SEARCH_FRAMEWORK_REPOSITORY=
JOB_SEARCH_FRAMEWORK_SHA=
# Absolute path only. The config names public sale sources/payees and points to any private credential file.
LM_X402_SALE_OBSERVER_CONFIG=

# --- Operator-only DEV/self-heal Railway target ---
# Keep every value empty until the installation owner has verified CLI access and readback. The
# controlled production error injector additionally requires the Postgres service selector.
LM_DEV_RAILWAY_PROJECT_ID=
LM_DEV_RAILWAY_APP_SERVICE=
LM_DEV_RAILWAY_POSTGRES_SERVICE=
LM_DEV_RAILWAY_ENVIRONMENT=
LM_DEV_HEALTH_URL=

# --- Base: one installation-owned BotFather bot + public Core origin ---
# Run `npm run telegram:configure` instead of putting the token in shell history. Webhook mode needs
# an HTTPS origin reachable by Telegram. NEXT_PUBLIC_* is also set in each Web app's build settings.
LM_TELEGRAM_MODE=byob_single
LM_TELEGRAM_BOT_TOKEN=
LM_TELEGRAM_BOT_USERNAME=
LM_TELEGRAM_WEBHOOK_SECRET=
LM_LATE_APPROVAL_CALLBACK_SECRET=
LM_PUBLIC_URL=
LM_PANEL_BASE_URL=
LM_WEB_ORIGIN=
NEXT_PUBLIC_LM_TELEGRAM_BOT_USERNAME=
# Public, non-secret welcome link for the avocadomini 3-tool selector.
DORAEMON_SITE_START_URL=https://doraos.vercel.app/start
LM_TIME_ZONE=Asia/Tokyo

# --- Core data plane ---
# The bundled local Postgres stores runtime jobs only. Current Telegram/Panel/daily Core still reads
# an installation-owned Supabase project whose Rockstar_ibot schema has been applied.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Generate a different random value for every secret (for example, `openssl rand -hex 32`). Do not
# reuse the Telegram webhook secret, and never expose these through NEXT_PUBLIC_* variables.
LM_UID_SECRET=
LM_PANEL_SESSION_ROTATION_SECRET=
LM_CALL_SECRET=
LM_FEEDBACK_PROVENANCE_KEY=
LM_INBOUND_SECRET=
LM_RELATIONS_HASH_SECRET=

# Optional PostgreSQL store for feedback/browser jobs. The required feature migrations must exist.
LM_FEEDBACK_DATABASE_URL=
LM_FEEDBACK_DATABASE_PUBLIC_URL=

# --- Google Calendar, Maps, and reasoning ---
# Optional transport selection. Empty means the current Composio default. `gog` and `unipile`
# have the deployment/code limitations documented in docs/owner-tools-setup.ja.md.
LIFE_TRANSPORT=
LIFE_CAL_TRANSPORT=
COMPOSIO_API_KEY=
COMPOSIO_GCAL_AUTH_CONFIG=
# Optional local/single-owner GOG transport. It is not bundled in the runtime Docker image.
GOG_ACCOUNT=
GOG_BIN=
GOG_KEYRING_PASSWORD=
# Set LIFE_MAPS_KEY or GOOGLE_API_KEY. LIFE_MAPS_KEY takes precedence.
LIFE_MAPS_KEY=
GOOGLE_API_KEY=
GEMINI_API_KEY=

# --- Voice calls: installation-owned Telnyx account ---
TELNYX_API_KEY=
TELNYX_CONNECTION_ID=
TELNYX_PHONE_NUMBER=
TELNYX_PUBLIC_KEY=
PUBLIC_WSS=
LM_AMD=on
MAX_CONCURRENT_CALLS=8

# --- Billing: installation-owned Stripe account ---
# Current entitlement handling is driven by signed webhook events. LM_STRIPE_PAYMENT_LINK must be a
# Payment Link created in that same account. STRIPE_SECRET_KEY is reserved for future server calls.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
LM_STRIPE_PAYMENT_LINK=
LM_DORAEMON_PAYMENT_LINK=
STRIPE_DEV=0

# --- Email / Gmail (provider wiring exists, but the fresh-user Gmail callback is not release-ready) ---
# Never fall back to somebody else's domain: both addresses must belong to domains you control.
RESEND_API_KEY=
LM_MAIL_FROM=
LM_REPLY_DOMAIN=
UNIPILE_DSN=
UNIPILE_TOKEN=
UNIPILE_NOTIFY_SECRET=

# --- Optional durable execution ---
# Use this only when Inngest, rather than the in-process scheduler, owns the write cadence. The
# current inbound endpoint reads INNGEST_SIGNING_KEY. INNGEST_EVENT_KEY is reserved for future
# server-side event sends and is not required by the current runtime.
INNGEST_SIGNING_KEY=
INNGEST_EVENT_KEY=

# --- Optional browser agent (requires a separate private steel-browser service) ---
LM_BROWSER_TASKS_ENABLED=0
LM_BROWSER_SESSION_KEY=
LM_BROWSER_E2E_ORIGIN=
LM_AGENT_BROWSER_EMAIL=
LM_AGENT_BROWSER_NAME=

# --- Optional owner notification ---
LM_ADMIN_TELEGRAM_CHAT_ID=
LM_TELEGRAM_ALERT_CHAT_ID=

# --- Optional social publication worker (disabled unless capabilities/gates are enabled) ---
# These are container-side paths. Publish capabilities remain empty/disabled until the owner has
# replaced and verified every legacy operator lane described in the runbook.
LM_DATA_DIR=/var/lib/rockstar_ibot/data
LM_WORKER_CAPABILITIES=
LM_RUNTIME_TENANT_ID=
LM_POSTIZ_API_KEY=
LM_INSTAGRAM_HANDLE=
LM_INSTAGRAM_ACCOUNTS_PATH=
LM_INSTAGRAM_SETTINGS_PATH=
LM_INSTAGRAM_CREDENTIALS_PATH=
LM_INSTAGRAM_PROFILE_STATE_DIR=
LM_TIKTOK_INTEGRATION=
LM_HONNE_EN_INSTAGRAM_PROFILE_REF=
LM_HONNE_EN_TIKTOK_INTEGRATION_REF=

# --- Product Hunt discovery (never set true without actual commercial permission) ---
PRODUCT_HUNT_ACCESS_TOKEN=
PRODUCT_HUNT_COMMERCIAL_API_APPROVED=false
