# Rockstar_ibot owns these roots in both local and cloud modes.
LM_MODE=local
LM_DATA_DIR=/absolute/path/to/rockstar_ibot/data
LM_CACHE_DIR=/absolute/path/to/rockstar_ibot/cache
LM_GITHUB_REPOSITORY=
ANICCA_FORUM_REPO=
GITHUB_IDENTITY=
LM_SOURCE_REPOSITORY_URL=
LM_X402_DISCOVERY_HEALTH_URL=
JOB_SEARCH_FRAMEWORK_REPOSITORY=
JOB_SEARCH_FRAMEWORK_SHA=
LM_X402_SALE_OBSERVER_CONFIG=

# Operator-only DEV/self-heal lane. Leave disabled until every owner target is verified.
LM_DEV_RAILWAY_PROJECT_ID=
LM_DEV_RAILWAY_APP_SERVICE=
LM_DEV_RAILWAY_POSTGRES_SERVICE=
LM_DEV_RAILWAY_ENVIRONMENT=
LM_DEV_HEALTH_URL=

# The complete current Core template is deploy/local/.env.example. Job payloads store references;
# actual values live in the local keychain or tenant vault. runtime-up currently reads this name.
LM_TELEGRAM_TOKEN_REF=secret://telegram/bot-token

# Current Telegram connector: one installation-owned BotFather bot per deployment.
# Use `npm run telegram:configure`; do not commit the populated env file.
LM_TELEGRAM_MODE=byob_single
LM_TELEGRAM_BOT_TOKEN=
LM_TELEGRAM_BOT_USERNAME=
LM_TELEGRAM_WEBHOOK_SECRET=
# Telegram内で販売するデジタル商品はStars(XTR)固定。payloadは128byte以下の固定商品ID。
# 法定表示・価格・返金窓口・実決済E2Eを確認するまで0のままにする。
LM_DORAEMON_STARS_ENABLED=0
LM_DORAEMON_STARS_AMOUNT=
LM_DORAEMON_STARS_PAYLOAD=dora-os-lifetime-v1
DORAEMON_TERMS_URL=https://effect-os-verified.kirin-999.chatgpt.site/legal
DORAEMON_PRIVACY_URL=https://effect-os-verified.kirin-999.chatgpt.site/privacy
# Public site opened by the Telegram welcome button; override for a different owner-controlled site.
DORAEMON_SITE_START_URL=https://doraos.vercel.app/start
LM_LATE_APPROVAL_CALLBACK_SECRET=
LM_PUBLIC_URL=
LM_PANEL_BASE_URL=
LM_WEB_ORIGIN=
NEXT_PUBLIC_LM_TELEGRAM_BOT_USERNAME=
LM_BROWSER_E2E_ORIGIN=

# Telegram → local Codex bridge. The bridge runs on Kai's Mac, not in Railway, because the
# Codex ChatGPT login is local. Keep the token in Railway Secret Variables and macOS Keychain.
LM_CODEX_BRIDGE_ENABLED=0
LM_CODEX_ALLOWED_CHAT_IDS=
LM_CODEX_BRIDGE_TOKEN=
LM_CODEX_BRIDGE_BASE_URL=
LM_CODEX_BRIDGE_TOKEN_SERVICE=com.k999ln.mr.codex-telegram-bridge
LM_CODEX_BRIDGE_TOKEN_ACCOUNT=
LM_CODEX_WORKDIR=

# Current Core provider ownership/settings are documented in:
# ../../docs/owner-tools-setup.ja.md
