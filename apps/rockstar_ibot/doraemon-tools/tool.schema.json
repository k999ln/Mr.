{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/doraemon-tool.schema.json",
  "title": "avocadomini tool manifest",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "id", "feature_key", "order", "name", "actor", "description", "emoji", "public_verb", "public_detail", "room_summary", "input_hint", "output_hint", "first_step", "example", "notices", "marketing_title", "marketing_body", "draft_instruction", "phase", "implementation_state", "free_tier_eligible", "effect_class", "owner_approval", "receipt_required", "capability_ids", "connector_keys", "maintainers"],
  "properties": {
    "schema_version": { "const": 1 },
    "id": { "type": "string", "pattern": "^[a-z][a-z0-9]*(?:-[a-z0-9]+)*$" },
    "feature_key": { "enum": ["request", "course", "check", "store", "promote", "nurture", "pay", "deliver", "measure", "split"] },
    "order": { "type": "integer", "minimum": 1, "maximum": 9999 },
    "name": { "type": "string", "minLength": 1, "maxLength": 80 },
    "actor": { "type": "string", "minLength": 1, "maxLength": 80 },
    "description": { "type": "string", "minLength": 1, "maxLength": 240 },
    "emoji": { "type": "string", "minLength": 1, "maxLength": 8 },
    "public_verb": { "type": "string", "minLength": 1, "maxLength": 80 },
    "public_detail": { "type": "string", "minLength": 1, "maxLength": 160 },
    "room_summary": { "type": "string", "minLength": 1, "maxLength": 240 },
    "input_hint": { "type": "string", "minLength": 1, "maxLength": 240 },
    "output_hint": { "type": "string", "minLength": 1, "maxLength": 240 },
    "first_step": { "type": "string", "minLength": 1, "maxLength": 300 },
    "example": { "type": "string", "minLength": 1, "maxLength": 300 },
    "notices": { "type": "string", "minLength": 1, "maxLength": 240 },
    "marketing_title": { "type": "string", "minLength": 1, "maxLength": 120 },
    "marketing_body": { "type": "string", "minLength": 1, "maxLength": 500 },
    "draft_instruction": { "type": "string", "minLength": 1, "maxLength": 1000 },
    "phase": { "enum": ["intake", "create", "verify", "sell", "promote", "nurture", "pay", "deliver", "measure", "settle", "other"] },
    "implementation_state": { "enum": ["catalog_only", "foundation", "implemented_unconfigured", "runtime_ready"] },
    "free_tier_eligible": { "type": "boolean" },
    "effect_class": { "enum": ["none", "message", "publish", "money"] },
    "owner_approval": { "enum": ["none", "install", "per_invocation"] },
    "receipt_required": { "type": "boolean" },
    "capability_ids": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "type": "string", "pattern": "^[a-z][a-z0-9]*(?:[.-][a-z0-9]+)+$" } },
    "connector_keys": { "type": "array", "uniqueItems": true, "items": { "type": "string", "pattern": "^[a-z][a-z0-9]*(?:-[a-z0-9]+)*$" } },
    "maintainers": { "type": "array", "uniqueItems": true, "items": { "type": "string", "pattern": "^@[A-Za-z0-9-]{1,39}$" } }
  }
}
