<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>ai.k999ln.mr-codex-telegram-bridge</string>
  <key>ProgramArguments</key>
  <array>
    <string>__NODE_BIN__</string>
    <string>__APP_DIR__/scripts/codex-telegram-bridge.js</string>
  </array>
  <key>EnvironmentVariables</key>
  <dict>
    <key>HOME</key><string>__HOME__</string>
    <key>PATH</key><string>/Users/noelle/.local/bin:/opt/homebrew/bin:/usr/local/bin:/usr/bin:/bin:/usr/sbin:/sbin</string>
    <key>CODEX_HOME</key><string>__CODEX_HOME__</string>
    <key>LM_CODEX_BRIDGE_BASE_URL</key><string>__BRIDGE_BASE_URL__</string>
    <key>LM_CODEX_BRIDGE_TOKEN_SERVICE</key><string>com.k999ln.mr.codex-telegram-bridge</string>
    <key>LM_CODEX_BRIDGE_TOKEN_ACCOUNT</key><string>__ACCOUNT__</string>
    <key>LM_CODEX_WORKDIR</key><string>__APP_DIR__/../../..</string>
  </dict>
  <key>WorkingDirectory</key><string>__APP_DIR__</string>
  <key>RunAtLoad</key><true/>
  <key>ThrottleInterval</key><integer>30</integer>
  <key>ProcessType</key><string>Background</string>
  <key>StandardOutPath</key><string>__HOME__/.local/state/rockstar_ibot/logs/codex-telegram-bridge.out.log</string>
  <key>StandardErrorPath</key><string>__HOME__/.local/state/rockstar_ibot/logs/codex-telegram-bridge.err.log</string>
</dict>
</plist>
