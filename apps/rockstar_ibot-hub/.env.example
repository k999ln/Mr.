# HTTPS Life Manager Core entry owned by this deployment. Leave unset to keep
# Core connection cards on the local Connections setup section.
NEXT_PUBLIC_LM_PRODUCT_URL=

# BotFather username owned by this deployment, without the leading @.
# Leave unset to show the BYO Telegram Bot setup guide.
NEXT_PUBLIC_LM_TELEGRAM_BOT_USERNAME=

# Server-only Cloudflare Core identity bridge. Never prefix the secret with
# NEXT_PUBLIC_ and never commit its value.
LM_CLOUDFLARE_CORE_URL=https://life-manager-cloudflare-core.example.workers.dev
LM_HUB_LINK_SECRET=
