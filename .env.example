# Rockstar_ibot / Kai-owned configuration template
# Copy the complete template from deploy/local/.env.example to deploy/local/.env and chmod 600.
# Empty values disable the corresponding capability. Never insert former-owner credentials.

# Public owner/source identity
LM_GITHUB_REPOSITORY=
ANICCA_FORUM_REPO=
GITHUB_IDENTITY=
LM_SOURCE_REPOSITORY_URL=
LM_X402_DISCOVERY_HEALTH_URL=
JOB_SEARCH_FRAMEWORK_REPOSITORY=
JOB_SEARCH_FRAMEWORK_SHA=
# Absolute path to a private operator-owned sale-source configuration JSON.
LM_X402_SALE_OBSERVER_CONFIG=
LM_PUBLIC_URL=
LM_PANEL_BASE_URL=
LM_WEB_ORIGIN=
NEXT_PUBLIC_LM_PRODUCT_URL=

# Telegram: one installation-owned BotFather bot
LM_TELEGRAM_MODE=byob_single
LM_TELEGRAM_BOT_TOKEN=
LM_TELEGRAM_BOT_USERNAME=
LM_TELEGRAM_WEBHOOK_SECRET=
LM_LATE_APPROVAL_CALLBACK_SECRET=
NEXT_PUBLIC_LM_TELEGRAM_BOT_USERNAME=

# Core data plane
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
LM_UID_SECRET=
LM_PANEL_SESSION_ROTATION_SECRET=
LM_FEEDBACK_PROVENANCE_KEY=
LM_RELATIONS_HASH_SECRET=

# Calendar / Maps / AI
LIFE_TRANSPORT=
LIFE_CAL_TRANSPORT=
COMPOSIO_API_KEY=
COMPOSIO_GCAL_AUTH_CONFIG=
GOG_ACCOUNT=
LIFE_MAPS_KEY=
GOOGLE_API_KEY=
GEMINI_API_KEY=

# Voice
TELNYX_API_KEY=
TELNYX_CONNECTION_ID=
TELNYX_PHONE_NUMBER=
TELNYX_PUBLIC_KEY=
PUBLIC_WSS=
LM_CALL_SECRET=

# Billing
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
LM_STRIPE_PAYMENT_LINK=
LM_DORAEMON_PAYMENT_LINK=
# Fail-closed verification for the exact Doraemon checkout. Use IDs from the
# same Stripe mode as LM_DORAEMON_PAYMENT_LINK (test and live must never mix).
LM_DORAEMON_PAYMENT_LINK_ID=
LM_DORAEMON_PRODUCT_ID=
LM_DORAEMON_PRICE_ID=
LM_DORAEMON_AMOUNT_TOTAL=4980
LM_DORAEMON_CURRENCY=jpy

# Mail
RESEND_API_KEY=
LM_MAIL_FROM=
LM_REPLY_DOMAIN=
LM_INBOUND_SECRET=

# Optional legacy automaton reporting. Empty means no report or telemetry is sent.
ANICCA_REPORT_TO=
AGENTMAIL_API_KEY=
AGENTMAIL_INBOX=
ANICCA_TELEMETRY_URL=
ANICCA_DASHBOARD_SYNC=
ANICCA_DASHBOARD_URL=

# Optional browser / feedback data plane
LM_FEEDBACK_DATABASE_URL=
LM_FEEDBACK_DATABASE_PUBLIC_URL=
LM_BROWSER_SESSION_KEY=
LM_BROWSER_E2E_ORIGIN=

# Optional public money rail. No default wallet is provided.
LIFE_MANAGER_PAY_TO=
LIFE_MANAGER_CONTACT_NAME=Kai
LIFE_MANAGER_CONTACT_EMAIL=
LIFE_MANAGER_CONTACT_URL=

# See deploy/local/.env.example and docs/owner-tools-setup.ja.md for the full matrix.
